# Porta do serviço
PORT=8080

# URL do front-end (usada no CORS)
FRONTEND_URL=http://localhost:5173

# JWT — OBRIGATÓRIO. Mesmo segredo do newelog-auth-service (mín. 32 caracteres)
# Gere com: openssl rand -base64 48
JWT_SECRET=

# Banco de dados (PostgreSQL) — OBRIGATÓRIO
# Rodando o serviço fora do Docker, o host é localhost.
# Dentro do docker compose, troque localhost pelo nome do serviço (motoristas-db).
DB_URL=jdbc:postgresql://localhost:5432/motoristas
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000